---
interface Crumb {
  name: string;
  href: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const data = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.href, "https://andrepreer.com").href,
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((crumb, index) => (
        <li>
          {index < crumbs.length - 1 ? <a href={crumb.href}>{crumb.name}</a> : <span aria-current="page">{crumb.name}</span>}
          {index < crumbs.length - 1 ? <span aria-hidden="true"> / </span> : null}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
