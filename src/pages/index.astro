---
import Base from "../layouts/Base.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import ConceptSlot from "../components/ConceptSlot.astro";
import CtaBand from "../components/CtaBand.astro";
import { businessJsonLd, processSteps, reasons, servicesIn, site } from "../data/site";
import { seasonEmphasis } from "../data/season";

const interior = seasonEmphasis === "interior";
const preload = undefined;
const featured = interior ? servicesIn("kitchen") : servicesIn("exterior");
const later = interior ? servicesIn("exterior") : servicesIn("kitchen");
const laterTitle = interior ? "The yard, the stone, and the outdoor rooms" : "Kitchens, when you are ready to come inside";
const laterCopy = interior
  ? "Landscape, limestone, patios, planting, and fire features are still part of the practice. They sit below the kitchen work on this page because the season is interior. The service pages themselves do not change."
  : "Full remodels, backsplash, cabinets, counters, islands, and finishing stay on the site all year. In this season the home page leads with the yard.";
---

<Base
  title={interior
    ? "Kitchen Remodeling & Backsplash in Springfield, IL | Andre Preer"
    : "Landscape, Stone & Outdoor Living in Springfield, IL | Andre Preer"}
  description={interior
    ? "Andre Preer remodels kitchens in Springfield and Central Illinois, with backsplash installation up front, and still builds landscape, stone, and outdoor rooms."
    : "Andre Preer designs and builds landscapes, limestone, and outdoor rooms in Springfield and Central Illinois, and remodels kitchens, including backsplash and cabinets."}
  jsonLd={businessJsonLd()}
  preload={preload}
>
  <main id="main">
    {
      interior ? (
        <section class="hero-split" aria-label="Introduction">
          <div class="wrap split hero-split-grid">
            <div>
              <p class="eyebrow">Springfield kitchens, this season</p>
              <h1>The backsplash, and the kitchen around it.</h1>
              <p class="lede">
                {site.person} remodels kitchens in {site.area}: full remodels, backsplash, cabinets, countertops, islands, and the lighting that finishes the room. The yard and the stone are still part of the work. They are listed further down.
              </p>
              <div class="actions">
                <a class="btn btn-solid" href={`tel:${site.phoneTel}`}>
                  Call Andre · {site.phoneDisplay}
                </a>
                <a class="btn btn-line" href="/contact/?type=backsplash-installation">
                  Request a consultation
                </a>
              </div>
            </div>
            <ConceptSlot
              id="hero-kitchen"
              ratio="photo"
              priority={true}
              label="Design concept"
              alt="White kitchen with a farmhouse sink, pale tile backsplash, and a wood island. Design concept, not a finished project."
            />
          </div>
        </section>
      ) : (
        <section class="hero-split" aria-label="Introduction">
          <div class="wrap split hero-split-grid">
            <div>
              <p class="eyebrow">Springfield yards, this season</p>
              <h1>A whole yard, not one trade at a time.</h1>
              <p class="lede">
                {site.person} designs and builds residential landscapes in {site.area}: planting, limestone, patios, fire features, and specialty stone. Kitchens and backsplash stay on the site. They are listed further down.
              </p>
              <div class="actions">
                <a class="btn btn-solid" href={`tel:${site.phoneTel}`}>
                  Call Andre · {site.phoneDisplay}
                </a>
                <a class="btn btn-line" href="/contact/">
                  Request a consultation
                </a>
              </div>
            </div>
            <ConceptSlot
              id="outdoor-fire"
              ratio="photo"
              priority={true}
              label="Design concept"
              alt="A stone patio with a fire pit and wooden chairs beside a brick house. Design concept, not a finished project."
            />
          </div>
        </section>
      )
    }

    <section>
      <div class="wrap">
        {
          interior ? (
            <>
              <div class="section-head">
                <p class="eyebrow">Featured</p>
                <h2>Backsplash installation</h2>
                <p>
                  The backsplash is the piece that makes a kitchen look finished or look patched. Andre sets it with the counter and the cabinets, whether the job is only the tile or a full remodel.
                </p>
                <p>
                  <a href="/services/backsplash-installation/">Read the backsplash service</a>
                </p>
              </div>
              <BeforeAfter
                beforeId="backsplash-before"
                afterId="backsplash-after"
                caption="Backsplash style idea"
                beforeAlt="Oak cabinets and a short tile backsplash at a sink window. Before side of a design concept."
                afterAlt="The same sink wall with a taller pale tile backsplash and a light stone counter. Design concept, not a finished project."
              />
            </>
          ) : (
            <>
              <div class="section-head">
                <p class="eyebrow">Featured</p>
                <h2>Landscape, walls, and outdoor rooms</h2>
                <p>
                  Planting, limestone, patios, and fire features are planned as one yard. The photographs here are references, not a list of finished jobs.
                </p>
              </div>
              <div class="ref-grid">
                <ConceptSlot
                  id="landscaped-bed"
                  label="Design concept"
                  alt="A brick house front with a planted bed of shrubs and flowers. Design concept, not a finished project."
                />
                <ConceptSlot
                  id="stone-patio"
                  label="Design concept"
                  alt="An irregular stone patio and walk beside a brick house and lawn. Design concept, not a finished project."
                />
              </div>
            </>
          )
        }
      </div>
    </section>

    <section class="tight">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{interior ? "This season" : "On the grounds"}</p>
          <h2>{interior ? "What a kitchen project can include" : "What a yard project can include"}</h2>
        </div>
        <ol class="service-index">
          {
            featured.map((service, index) => (
              <li>
                <a href={`/services/${service.slug}/`}>
                  <span class="num">{String(index + 1).padStart(2, "0")}</span>
                  <span>
                    <h3>{service.name}</h3>
                    <p>{service.summary}</p>
                  </span>
                  <span class="more">View</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{interior ? "A full kitchen" : "Before and after"}</p>
          <h2>{interior ? "The room, before and after the idea" : "A kitchen concept, kept on the page"}</h2>
          <p>
            These frames are design concepts. They are not photographs of a finished Andre Preer kitchen, and they are not tied to a customer or a street.
          </p>
        </div>
        <BeforeAfter
          beforeId="kitchen-before"
          afterId="kitchen-after"
          caption="Design concept"
          beforeAlt="Oak kitchen with a peninsula and two stools. Before side of a design concept."
          afterAlt="The same kitchen with white cabinets, a pale backsplash, and wood-look flooring. Design concept, not a finished project."
        />
      </div>
    </section>

    <section class="why">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Why call</p>
          <h2>Why homeowners call Andre</h2>
          <p>No year count, no review score, and no license number. These are the parts of the practice the work is built on.</p>
        </div>
        <div class="why-grid">
          {
            reasons.map((reason) => (
              <article>
                <h3>{reason.title}</h3>
                <p>{reason.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id={interior ? "exterior" : "kitchens"}>
      <div class="wrap split">
        <div>
          <p class="eyebrow">{interior ? "Also the grounds" : "Also the kitchen"}</p>
          <h2>{laterTitle}</h2>
          <p>{laterCopy}</p>
          <p>
            <a href={interior ? "/services/#exterior" : "/services/#kitchens"}>
              {interior ? "All exterior services" : "All kitchen services"}
            </a>
          </p>
        </div>
        <div>
          {
            interior && (
              <ConceptSlot
                id="house-exterior"
                label="Design concept"
                alt="Design concept of a Springfield-style house exterior. Not a finished project and not Andre’s address."
              />
            )
          }
          <ul class="project-list">
            {
              later.map((service) => (
                <li>
                  <a href={`/services/${service.slug}/`}>{service.name}</a>
                </li>
              ))
            }
            <li>
              <a href="/services/interior-exterior/">Interior and exterior, planned together</a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">Approach</p>
          <h2>Walk the place, then build the scope you agreed to.</h2>
          <p>
            A kitchen, a yard, or both. The short version is the same: look at how you use it, write a scope you can accept or decline, then build that scope. The full sequence is on the process page.
          </p>
          <p>
            <a href="/process/">See how a project proceeds</a>
          </p>
        </div>
        <ol class="steps">
          {
            processSteps.slice(1, 4).map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">Service area</p>
          <h2>{site.area}</h2>
          <p>
            The practice is based in Springfield. Name the town when you call or on the form. Andre will say whether the trip makes sense. No radius is promised here, and the street address is not published.
          </p>
        </div>
        <div class="panel">
          <h3>Start with the room or the yard</h3>
          <p>Say whether it is the kitchen, the grounds, or both, and how to reach you. A budget range is optional and is not a quote.</p>
          <p>
            <a href="/contact/">Request a consultation</a>
          </p>
        </div>
      </div>
    </section>

    <CtaBand
      heading={interior ? "Tell Andre about the kitchen." : "Tell Andre about the yard."}
      text="Call if you want to talk now. The form reaches the same person, whether the job is a backsplash, a full remodel, or the landscape outside."
    />
  </main>
</Base>
