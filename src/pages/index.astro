---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import ConceptSlot from "../components/ConceptSlot.astro";
import CtaBand from "../components/CtaBand.astro";
import { conceptImages } from "../data/concepts";
import { businessJsonLd, processSteps, reasons, servicesIn, site } from "../data/site";
import { seasonEmphasis } from "../data/season";

const interior = seasonEmphasis === "interior";
const lead = servicesIn(interior ? "interior" : "exterior");
const other = servicesIn(interior ? "exterior" : "interior");
const hero = conceptImages[interior ? "hero-kitchen" : "outdoor-fire"];
const heroAlt = interior
  ? "A bright white kitchen with a farmhouse sink, a pale tile backsplash, and a wood island. Design concept image, not a finished Andre Preer project."
  : "A square stone fire pit with wooden chairs on a flagstone patio, with a curved stone seat wall and mature trees behind. Design concept image, not a finished Andre Preer project.";
---

<Base
  title="Interior Stonework, Kitchens & Landscaping in Springfield, IL | Andre Preer"
  description="Interior design with stonework and tile, kitchen and bathroom remodeling, plus landscaping and hardscaping for Springfield and Central Illinois homes. Request an estimate."
  jsonLd={businessJsonLd()}
>
  <main id="main">
    <section class="hero" aria-label="Introduction">
      <div class="hero-media">
        <Picture
          src={hero}
          formats={["avif", "webp"]}
          widths={[480, 768, 1152, 1600]}
          sizes="100vw"
          alt={heroAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="wrap">
        <div class="hero-copy rise">
          <p class="eyebrow">
            {interior ? "Interiors · Stonework · Tile" : "Landscape · Hardscape · Stonework"}
          </p>
          <h1>Thoughtfully designed. Beautifully built.</h1>
          <span class="rule" aria-hidden="true"></span>
          <p class="lede">
            {
              interior
                ? "Interior design, kitchens, bathrooms, tile, and custom stonework, with landscaping and hardscaping outside, for homes throughout Springfield and Central Illinois."
                : "Landscaping, hardscaping, and custom stonework, with kitchens, bathrooms, and interior tile and stone inside, for homes throughout Springfield and Central Illinois."
            }
          </p>
          <div class="actions">
            <a class="btn btn-light" href="/contact/">Request an estimate</a>
            <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
          </div>
          <p class="photo-note">Design concept image. Not a finished Andre Preer project.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">The practice</p>
          <h2>Stone and tile, treated as design. Inside and out.</h2>
        </div>
        <div>
          <p class="lede">
            {site.person} designs and builds in {site.area}. In winter the focus is the interior: kitchens, bathrooms, and the stonework and tile that make a room. The rest of the year it moves outside to landscape, walls, patios, and fire features.
          </p>
          <p>
            <a href="/about/">About Andre</a>
          </p>
        </div>
      </div>
    </section>

    <section class="tight">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{interior ? "Interiors" : "Exterior"}</p>
          <h2>{interior ? "Kitchens, bathrooms, stone and tile" : "Landscape, stone, and outdoor rooms"}</h2>
        </div>
        <ol class="service-index">
          {
            lead.map((service, index) => (
              <li>
                <a href={`/services/${service.slug}/`}>
                  <span class="num">{String(index + 1).padStart(2, "0")}</span>
                  <span>
                    <h3>{service.name}</h3>
                    <p>{service.summary}</p>
                  </span>
                  <span class="more">View</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="stone-band">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">{interior ? "Featured" : "The look"}</p>
          <h2>{interior ? "The backsplash, and the kitchen around it" : "Natural materials, kept in proportion"}</h2>
          <p>
            These images are design concepts, not photographs of finished jobs. Real project photography replaces them as it is added.
          </p>
        </div>
        {
          interior ? (
            <BeforeAfter
              beforeId="backsplash-before"
              afterId="backsplash-after"
              caption="Backsplash style idea"
              beforeAlt="Oak cabinets and a short tile backsplash at a sink window. Before side of a design concept."
              afterAlt="The same sink wall with a taller pale tile backsplash and a light stone counter. Design concept, not a finished project."
            />
          ) : (
            <div class="ref-grid">
              <ConceptSlot
                id="stone-patio"
                label="Design concept"
                alt="A curving flagstone walk and patio beside a brick house, with hostas and a lawn. Design concept, not a finished project."
              />
              <ConceptSlot
                id="landscaped-bed"
                label="Design concept"
                alt="A brick house front with layered shrubs, hydrangeas, and perennials in a mulched bed. Design concept, not a finished project."
              />
            </div>
          )
        }
        <p><a class="btn btn-line" href="/portfolio/">See the work page</a></p>
      </div>
    </section>

    <section class="why">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Why call Andre</p>
          <h2>How the work is approached</h2>
        </div>
        <div class="why-grid">
          {
            reasons.map((reason) => (
              <article>
                <h3>{reason.title}</h3>
                <p>{reason.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id={interior ? "exterior" : "interior"}>
      <div class="wrap split">
        <div>
          <p class="eyebrow">{interior ? "Also outside" : "Also inside"}</p>
          <h2>{interior ? "The yard, the stone, and the outdoor rooms" : "Kitchens, bathrooms, stone and tile"}</h2>
          <p>
            {
              interior
                ? "Landscape, limestone, patios, planting, and fire features are the same practice moved outdoors, and they are what Andre builds the rest of the year."
                : "Andre’s winter focus is the interior. Kitchens, bathrooms, and stonework and tile stay on the site all year."
            }
          </p>
          <p>
            <a href={interior ? "/services/#exterior" : "/services/#interior"}>
              {interior ? "All exterior services" : "All interior services"}
            </a>
          </p>
        </div>
        <ul class="project-list">
          {
            other.map((service) => (
              <li>
                <a href={`/services/${service.slug}/`}>{service.name}</a>
              </li>
            ))
          }
          <li>
            <a href="/services/interior-exterior/">Interior and exterior, planned together</a>
          </li>
        </ul>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">Process</p>
          <h2>Walk the place, then build the scope you agreed to.</h2>
          <p>
            Look at how you use the room or the yard, write a scope you can accept or decline, then build that scope. The full sequence is on the process page.
          </p>
          <p>
            <a href="/process/">See how a project proceeds</a>
          </p>
        </div>
        <ol class="steps">
          {
            processSteps.slice(1, 4).map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">Service area</p>
          <h2>{site.area}</h2>
          <p>
            Based in Springfield. Name your town when you call or on the form, and Andre will say whether the trip makes sense. No street address is published.
          </p>
        </div>
        <div class="panel">
          <h3>Start with a conversation</h3>
          <p>Say whether it is a kitchen, a bathroom, the yard, or more than one, and how to reach you. A budget range is optional.</p>
          <p>
            <a href="/contact/">Request an estimate</a>
          </p>
        </div>
      </div>
    </section>

    <CtaBand
      heading="Tell Andre about the project."
      text="Call if you want to talk now. The form reaches the same person, whether the job is a backsplash, a bathroom, a wall, or the whole yard."
    />
  </main>
</Base>
