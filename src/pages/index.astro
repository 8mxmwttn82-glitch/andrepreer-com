---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import ConceptSlot from "../components/ConceptSlot.astro";
import CtaBand from "../components/CtaBand.astro";
import { conceptImages } from "../data/concepts";
import { businessJsonLd, processSteps, reasons, servicesIn, site } from "../data/site";

const exterior = servicesIn("exterior");
const hero = conceptImages["outdoor-fire"];
---

<Base
  title="Landscaping & Stonework in Springfield, IL | Andre Preer"
  description="Landscape design, hardscaping, patios, retaining walls, and custom stonework for Springfield and Central Illinois homes. Request an estimate from Andre Preer."
  jsonLd={businessJsonLd()}
>
  <main id="main">
    <section class="hero" aria-label="Introduction">
      <div class="hero-media">
        <Picture
          src={hero}
          formats={["avif", "webp"]}
          widths={[480, 768, 1152]}
          sizes="100vw"
          alt="A square stone fire pit with wooden chairs on a flagstone patio, with a curved stone seat wall and mature trees behind. Design concept image, not a finished Andre Preer project."
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="wrap">
        <div class="hero-copy rise">
          <p class="eyebrow">Landscape · Hardscape · Stonework</p>
          <h1>Thoughtfully designed. Beautifully built.</h1>
          <span class="rule" aria-hidden="true"></span>
          <p class="lede">
            Exceptional landscaping, hardscaping, and custom stonework for homes throughout Springfield and Central Illinois.
          </p>
          <div class="actions">
            <a class="btn btn-light" href="/contact/">Request an estimate</a>
            <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
          </div>
          <p class="photo-note">Design concept image. Not a finished Andre Preer project.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">The approach</p>
          <h2>Stone, planting, and outdoor rooms, planned together.</h2>
        </div>
        <div>
          <p class="lede">
            {site.person} designs and builds residential landscapes in {site.area}. Walls, patios, walks, fire areas, and planting are drawn as one yard, so each piece is placed for a reason.
          </p>
          <p>
            <a href="/about/">About Andre</a>
          </p>
        </div>
      </div>
    </section>

    <section class="tight">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Services</p>
          <h2>What Andre builds</h2>
        </div>
        <ol class="service-index">
          {
            exterior.map((service, index) => (
              <li>
                <a href={`/services/${service.slug}/`}>
                  <span class="num">{String(index + 1).padStart(2, "0")}</span>
                  <span>
                    <h3>{service.name}</h3>
                    <p>{service.summary}</p>
                  </span>
                  <span class="more">View</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="stone-band">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">The look</p>
          <h2>Natural materials, kept in proportion.</h2>
          <p>
            Reference imagery for the kind of yard Andre designs. These are design concepts, not photographs of finished jobs. Real project photography will replace them as it is added.
          </p>
        </div>
        <div class="ref-grid">
          <ConceptSlot
            id="stone-patio"
            label="Design concept"
            alt="A curving flagstone walk and patio beside a brick house, with hostas and a lawn. Design concept, not a finished project."
          />
          <ConceptSlot
            id="landscaped-bed"
            label="Design concept"
            alt="A brick house front with layered shrubs, hydrangeas, and perennials in a mulched bed. Design concept, not a finished project."
          />
        </div>
        <p><a class="btn btn-line" href="/portfolio/">See the work page</a></p>
      </div>
    </section>

    <section class="why">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Why call Andre</p>
          <h2>How the work is approached</h2>
        </div>
        <div class="why-grid">
          {
            reasons.map((reason) => (
              <article>
                <h3>{reason.title}</h3>
                <p>{reason.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">Process</p>
          <h2>Walk the place, then build the scope you agreed to.</h2>
          <p>
            Look at how you use the yard, write a scope you can accept or decline, then build that scope. The full sequence is on the process page.
          </p>
          <p>
            <a href="/process/">See how a project proceeds</a>
          </p>
        </div>
        <ol class="steps">
          {
            processSteps.slice(1, 4).map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p class="muted">{step.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section>
      <div class="wrap split">
        <div>
          <p class="eyebrow">Service area</p>
          <h2>{site.area}</h2>
          <p>
            Based in Springfield. Name your town when you call or on the form, and Andre will say whether the trip makes sense. No street address is published.
          </p>
        </div>
        <div class="panel">
          <h3>Start with a conversation</h3>
          <p>Tell Andre what the yard needs and how to reach you. A budget range is optional.</p>
          <p>
            <a href="/contact/">Request an estimate</a>
          </p>
        </div>
      </div>
    </section>

    <section class="tight">
      <div class="wrap">
        <p class="fine-line">
          Andre also takes on interior work, including kitchen backsplash and remodeling. <a href="/services/#kitchens">See interior services</a>.
        </p>
      </div>
    </section>

    <CtaBand
      heading="Tell Andre about the yard."
      text="Call if you want to talk now. The form reaches the same person, whether the job is a patio, a wall, or the whole landscape."
    />
  </main>
</Base>
