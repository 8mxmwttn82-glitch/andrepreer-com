---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CtaBand from "../../components/CtaBand.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import ConceptSlot from "../../components/ConceptSlot.astro";
import RefFigure from "../../components/RefFigure.astro";
import { photos, serviceBySlug, services, site } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const photo = service.image ? photos[service.image] : null;
const related = service.related.map((slug) => serviceBySlug(slug)).filter((item) => item !== undefined);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.description,
  url: `${site.url}/services/${service.slug}/`,
  areaServed: { "@type": "City", name: "Springfield", containedInPlace: { "@type": "State", name: "Illinois" } },
  provider: { "@id": `${site.url}/#business`, name: site.name, telephone: "+1-309-431-1805" },
};
---

<Base title={service.title} description={service.description} jsonLd={jsonLd}>
  <main id="main">
    <section>
      <div class="wrap">
        <Breadcrumbs
          crumbs={[
            { name: "Home", href: "/" },
            { name: "Services", href: "/services/" },
            { name: service.name, href: `/services/${service.slug}/` },
          ]}
        />
        <p class="eyebrow">Springfield &amp; Central Illinois</p>
        <h1>{service.h1}</h1>
        <p class="lede">{service.summary}</p>
      </div>
    </section>
    <section class="tight">
      <div class="wrap split">
        {
          service.slug === "backsplash-installation" ? (
            <div class="stack">
              <ConceptSlot
                id="herringbone"
                label="Backsplash style idea"
                alt="Close view of a herringbone tile backsplash in cream and pale green. Design concept, not a finished project."
              />
              <BeforeAfter
                beforeId="backsplash-before"
                afterId="backsplash-after"
                caption="Backsplash style idea"
                beforeAlt="Oak kitchen cabinets and a short tile backsplash at a sink window, shown as the before side of a design concept."
                afterAlt="The same sink wall with a taller pale tile backsplash and a light counter. Design concept, not a finished project."
              />
            </div>
          ) : service.slug === "full-kitchen-remodels" ? (
            <div class="stack">
              <BeforeAfter
                beforeId="kitchen-before"
                afterId="kitchen-after"
                caption="Design concept"
                beforeAlt="Oak kitchen with a laminate floor and a peninsula, shown as the before side of a design concept."
                afterAlt="The same kitchen layout with white cabinets, a pale backsplash, and wood-look flooring. Design concept, not a finished project."
              />
              <ConceptSlot
                id="island"
                label="Design concept"
                alt="A wood and white kitchen island with a stone top and two glass pendants. Design concept, not a finished project."
              />
            </div>
          ) : service.concept ? (
            <ConceptSlot
              id={service.concept}
              label="Design concept"
              alt={`${service.name}. Design concept, not a finished Andre Preer project.`}
            />
          ) : photo ? (
            <RefFigure photo={photo} sizes="(min-width: 900px) 36rem, 100vw" />
          ) : (
            <div class="plain-panel">
              <p class="eyebrow">Photographs</p>
              <p>No project photograph of this work is published yet. Ask Andre to show you examples when you meet.</p>
            </div>
          )
        }
        <div>
          <h2>The problem</h2>
          <p>{service.problem}</p>
          <h2>How Andre approaches it</h2>
          <p>{service.solution}</p>
        </div>
      </div>
    </section>
    <section class="tight">
      <div class="wrap two">
        <div class="panel">
          <h2>What you get</h2>
          <ul class="project-list">
            {service.benefits.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="panel">
          <h2>Typical projects of this kind</h2>
          <p class="hint">Examples of scope, not a list of past jobs or client sites.</p>
          <ul class="project-list">
            {service.projects.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
    <section class="tight">
      <div class="wrap">
        <h2>Related work</h2>
        <ul class="project-list">
          {related.map((item) => (
            <li><a href={`/services/${item.slug}/`}>{item.name}</a> — {item.summary}</li>
          ))}
          <li><a href="/portfolio/">Reference gallery</a></li>
          <li><a href={`/contact/?type=${service.slug}`}>Request a consultation about {service.name.toLowerCase()}</a></li>
        </ul>
      </div>
    </section>
    <CtaBand heading={`Talk with Andre about ${service.name.toLowerCase()}.`} text="Call the primary line, or send the property details through the form. Either one reaches him directly." />
  </main>
</Base>
