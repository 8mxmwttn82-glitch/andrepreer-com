---
import Base from "../layouts/Base.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ConceptSlot from "../components/ConceptSlot.astro";
import CtaBand from "../components/CtaBand.astro";
import Picture from "../components/Picture.astro";
import { photos } from "../data/site";
import manifest from "../data/images.json";

const largest = (id: string) => {
  const widths = (manifest as Record<string, { widths: number[] }>)[id].widths;
  return widths[widths.length - 1];
};

const gallery = [
  photos["residential-home-dusk"],
  photos["stone-home-and-lawn"],
  photos["stone-home-plantings"],
  photos["front-entry-planting"],
  photos["soil-and-hand-tools"],
];

// Upload-ready project framework. Each slot is a placeholder until Andre supplies
// real photographs and confirms the details. Do not add a project name, town, or
// client unless Andre has confirmed it.
const slots = [
  { category: "Patios and outdoor living", note: "Wide shot, detail shot, evening shot if available." },
  { category: "Walls and stonework", note: "Wall in context, close-up of the stone and joints." },
  { category: "Walkways and entries", note: "Approach to the door and a detail of the surface." },
  { category: "Landscape and planting", note: "Established bed, ideally in more than one season." },
  { category: "Fire features and gathering spaces", note: "Daytime and dusk views with seating." },
  { category: "Before and after", note: "Same angle, same spot, before work and after." },
];
---

<Base
  title="Work: Landscape & Stone Projects | Andre Preer, Springfield IL"
  description="Landscape, hardscape, and stonework imagery from Andre Preer. Design concepts and reference photos are labeled as such; finished project photography is being added."
>
  <main id="main">
    <section>
      <div class="wrap">
        <Breadcrumbs crumbs={[{ name: "Home", href: "/" }, { name: "Work", href: "/portfolio/" }]} />
        <p class="eyebrow">Work</p>
        <h1>Landscape, stone, and outdoor rooms.</h1>
        <p class="lede">
          Finished project photography is being added. Until then, every image here is labeled as a design concept or a reference photograph, not as a completed Andre Preer job. None of them name a client or a street.
        </p>
      </div>
    </section>

    <section class="tight">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Design concepts</p>
          <h2>The kind of yard Andre designs</h2>
        </div>
        <div class="ref-grid">
          <ConceptSlot id="outdoor-fire" label="Design concept" alt="A stone fire pit with chairs on a flagstone patio and a curved seat wall. Design concept, not a finished project." />
          <ConceptSlot id="stone-patio" label="Design concept" alt="A curving flagstone walk and patio beside a brick house. Design concept, not a finished project." />
          <ConceptSlot id="landscaped-bed" label="Design concept" alt="Layered planting along a brick house front. Design concept, not a finished project." />
        </div>
      </div>
    </section>

    <section class="stone-band" id="projects">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Project gallery</p>
          <h2>Finished projects, coming as photographs are added</h2>
          <p>
            Each frame below is a placeholder for a real project, grouped by the category it will appear in. Photographs of completed work, with Andre’s confirmation of what was built, replace these.
          </p>
        </div>
        <div class="slot-grid">
          {
            slots.map((slot) => (
              <div class="project-slot">
                <span class="slot-tag">Placeholder · awaiting project photos</span>
                <h3>{slot.category}</h3>
                <p>{slot.note}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <h2>Exterior reference photographs</h2>
        <p>These are not before-and-after pairs. House numbers in a photo belong to that reference image. They are not this business’s address.</p>
      </div>
      <div class="wrap gallery" id="gallery">
        {
          gallery.map((photo) => (
            <figure>
              <a class="shot" href={`/images/${photo.id}-${largest(photo.id)}.webp`} data-full={`/images/${photo.id}-${largest(photo.id)}.webp`} data-caption={photo.caption}>
                <span class="frame">
                  <Picture photo={photo} sizes="(min-width: 720px) 36rem, 100vw" />
                </span>
              </a>
              <figcaption>
                <span class="tag">Reference photo</span>
                {photo.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="tight">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Interior concepts</p>
          <h2>Kitchen and backsplash concepts</h2>
          <p>Interior services are listed on the services page. These frames are design concepts, not finished jobs.</p>
        </div>
        <BeforeAfter
          beforeId="backsplash-before"
          afterId="backsplash-after"
          caption="Backsplash style idea"
          beforeAlt="Design concept of a kitchen wall before a backsplash. Not a finished project."
          afterAlt="Design concept of a kitchen backsplash. Not a finished Andre Preer project."
        />
        <div class="ref-grid concept-grid">
          <ConceptSlot id="cabinets" label="Design concept" alt="Design concept of kitchen cabinets. Not a finished project." />
          <ConceptSlot id="countertops" label="Design concept" alt="Design concept of a kitchen countertop. Not a finished project." />
        </div>
      </div>
    </section>

    <CtaBand heading="Ask to see the work in person." text="A photograph is not a substitute for standing on a finished job. Call or request an estimate." />
  </main>
  <dialog class="lightbox" id="lightbox">
    <div class="lightbox-bar">
      <button type="button" data-prev>Previous</button>
      <button type="button" data-close>Close</button>
      <button type="button" data-next>Next</button>
    </div>
    <img id="lightbox-img" alt="Enlarged reference photograph" width="1600" height="1066" />
    <p id="lightbox-caption"></p>
  </dialog>
  <script is:inline src="/lightbox.js" defer></script>
</Base>
