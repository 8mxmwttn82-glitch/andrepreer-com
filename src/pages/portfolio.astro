---
import Base from "../layouts/Base.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ConceptSlot from "../components/ConceptSlot.astro";
import CtaBand from "../components/CtaBand.astro";
import Picture from "../components/Picture.astro";
import { photos } from "../data/site";
import manifest from "../data/images.json";

const largest = (id: string) => {
  const widths = (manifest as Record<string, { widths: number[] }>)[id].widths;
  return widths[widths.length - 1];
};

const gallery = [
  photos["residential-home-dusk"],
  photos["stone-home-and-lawn"],
  photos["stone-home-plantings"],
  photos["front-entry-planting"],
  photos["soil-and-hand-tools"],
  photos["interior-living-room"],
];
---

<Base
  title="Kitchen Concepts & Exterior References | Andre Preer"
  description="Design concepts for kitchens and backsplashes, plus reference photos for landscape and stone. None of these are labeled as finished Andre Preer jobs."
>
  <main id="main">
    <section>
      <div class="wrap">
        <Breadcrumbs crumbs={[{ name: "Home", href: "/" }, { name: "Work", href: "/portfolio/" }]} />
        <p class="eyebrow">Gallery</p>
        <h1>Concepts for the kitchen. References for the yard.</h1>
        <p class="lede">
          There is not a verified set of Andre’s finished projects on this site. The kitchen frames are design concepts. The yard photographs are references for houses, plantings, and materials. None of them are client jobs, and none of them name a street.
        </p>
      </div>
    </section>
    <section class="tight">
      <div class="wrap">
        <h2>Backsplash style idea</h2>
        <BeforeAfter
          beforeId="backsplash-before"
          afterId="backsplash-after"
          caption="Backsplash style idea"
          beforeAlt="Design concept of a kitchen wall before a backsplash. Not a finished project."
          afterAlt="Design concept of a kitchen backsplash. Not a finished Andre Preer project."
        />
      </div>
    </section>
    <section class="tight">
      <div class="wrap">
        <h2>A full kitchen, as a design concept</h2>
        <BeforeAfter
          beforeId="kitchen-before"
          afterId="kitchen-after"
          caption="Design concept"
          beforeAlt="Design concept of a kitchen before remodeling. Not a finished project."
          afterAlt="Design concept of a remodeled kitchen. Not a finished Andre Preer project."
        />
        <div class="ref-grid concept-grid">
          <ConceptSlot id="cabinets" label="Design concept" alt="Design concept of kitchen cabinets. Not a finished project." />
          <ConceptSlot id="countertops" label="Design concept" alt="Design concept of a kitchen countertop. Not a finished project." />
          <ConceptSlot id="island" label="Design concept" alt="Design concept of a kitchen island. Not a finished project." />
          <ConceptSlot id="herringbone" label="Backsplash style idea" alt="Herringbone tile backsplash in cream and pale green. Design concept, not a finished project." />
        </div>
      </div>
    </section>
    <section class="tight">
      <div class="wrap">
        <h2>Exterior reference photographs</h2>
        <p>These are not before-and-after pairs. House numbers in a photo belong to that reference image. They are not this business’s address.</p>
      </div>
      <div class="wrap gallery" id="gallery">
        {
          gallery.map((photo) => (
            <figure>
              <a class="shot" href={`/images/${photo.id}-${largest(photo.id)}.webp`} data-full={`/images/${photo.id}-${largest(photo.id)}.webp`} data-caption={photo.caption}>
                <span class="frame">
                  <Picture photo={photo} sizes="(min-width: 720px) 36rem, 100vw" />
                </span>
              </a>
              <figcaption>
                <span class="tag">Reference photo</span>
                {photo.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>
    <CtaBand heading="Ask to see the work in person." text="A reference photo is not a substitute for standing on a finished job. Call or request a consultation." />
  </main>
  <dialog class="lightbox" id="lightbox">
    <div class="lightbox-bar">
      <button type="button" data-prev>Previous</button>
      <button type="button" data-close>Close</button>
      <button type="button" data-next>Next</button>
    </div>
    <img id="lightbox-img" alt="Enlarged reference photograph" width="1600" height="1066" />
    <p id="lightbox-caption"></p>
  </dialog>
  <script is:inline src="/lightbox.js" defer></script>
</Base>
