{
  "name": "andrepreer",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "node scripts/images.mjs",
    "predev": "node scripts/images.mjs",
    "prebuild": "node scripts/images.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 4731",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4731",
    "test": "node --test src/server/handler.test.ts",
    "worker:dev": "wrangler dev --ip 127.0.0.1 --port 8788",
    "worker:bundle": "wrangler deploy --dry-run --outdir dist-worker"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/outfit": "^5.2.8",
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "sharp": "^0.34.4",
    "wrangler": "^4.50.0"
  }
}
